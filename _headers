# ===== 安全与性能响应头配置 =====

# ---- 全局安全头 ----
/*
  # 防点击劫持
  X-Frame-Options: SAMEORIGIN
  # 禁止 MIME 嗅探（防止内容类型混淆攻击）
  X-Content-Type-Options: nosniff
  # XSS 过滤（旧版浏览器兼容）
  X-XSS-Protection: 1; mode=block
  # Referrer 策略（防止 URL 泄露）
  Referrer-Policy: strict-origin-when-cross-origin
  # 禁用敏感浏览器 API（防设备滥用）
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()
  # HSTS 强制 HTTPS（1年，含子域）
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP：限制资源来源，防 XSS / 数据注入
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  # 禁止广告跟踪/指纹识别
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  # 反爬虫：禁止缓存探测、限制嵌入
  X-Robots-Tag: index, follow, noarchive
  # 移除服务器指纹
  X-Powered-By:

# ---- 静态资源：长期强缓存（内容哈希化时使用） ----
/css/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/js/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/images/*
  Cache-Control: public, max-age=31536000, immutable

/posts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ---- HTML 文件：协商缓存（确保内容更新可感知） ----
/*.html
  Cache-Control: no-cache, must-revalidate
  ETag: true

/
  Cache-Control: no-cache, must-revalidate
  ETag: true
